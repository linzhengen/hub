APP_ENV=local
LOG_LEVEL=5
POSTGRES_USER=postgres
POSTGRES_PASS=password#123
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_DB_NAME=hub
POSTGRES_SSL_MODE=disable
SQLCDEBUG=true
MIGRATION_AUTO=true
SEED_AUTO=false
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=hub
KEYCLOAK_CLIENT_ID=hub-api
KEYCLOAK_CLIENT_SECRET=test
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin
KEYCLOAK_ADMIN_REALM=master
APIKey=my-secret-key
# Local development answers chat from the mock LLM backend, so no Anthropic key
# and no network access are needed. To talk to the real API, set
# ANTHROPIC_MOCK=false and put a real key in ANTHROPIC_API_KEY.
ANTHROPIC_MOCK=true
ANTHROPIC_MOCK_DELAY=25ms
ANTHROPIC_API_KEY=
